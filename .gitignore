# Ignore generated page images
data/02_page_images/*
!data/02_page_images/.gitkeep

# Ignore cleaned pages
data/04_cleaned_pages/*
!data/04_cleaned_pages/.gitkeep

# Ignore merged documents
data/05_merged_documents/*
!data/05_merged_documents/.gitkeep

# Ignore cleaned documents
data/06_cleaned_documents/*
!data/06_cleaned_documents/.gitkeep

# Ignore chunked documents
data/07_chunked_documents/*
!data/07_chunked_documents/.gitkeep

# Ignore chunked documents
data/08_merged_chunked_documents/*
!data/08_merged_chunked_documents/.gitkeep

# Local models (large binaries — not committed)
models/generator/*
!models/generator/.gitkeep

models/retriever/*
!models/retriever/.gitkeep

# Ignore Internship Report
docs/Internship_Report.docx

# Locally generated human-evaluation databases (incl. WAL sidecar files)
reports/human_golden_question_evaluation/*.db
reports/human_golden_question_evaluation/*.db-*

# Hard links to the source PDFs, generated at startup so Streamlit can serve
# them (see publish_source_pdfs) -- rebuilt on every run, never committed
static/

# Local chat history written by the assistant's conversation rail (incl. the
# WAL sidecar files) -- per-machine, never committed
chat_history.db
chat_history.db-*

# Python
__pycache__/
*.pyc

# Environment
.env
.venv/

# macOS
.DS_Store
.claude/settings.local.json
